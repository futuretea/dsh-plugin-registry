# Copy to deploy/.env and fill in. Never commit the real .env.
GITLAB_URL=https://gitlab.example.com
# Token with read_api + read_repository scope
GITLAB_TOKEN=
# GitLab project (path) holding the reviewed allowlist.json, usually this repository
ALLOWLIST_GITLAB_PROJECT=platform/dsh-plugin-registry
# Branch to read the allowlist from; empty = project default branch
ALLOWLIST_REF=
DSH_PLUGIN_TOPIC=dsh-plugin
NPM_REGISTRY=
SANDBOX_IMAGE=node:24-alpine
INDEX_MAX_RISK=medium
# Seconds between generations (21600 = 6h)
GENERATE_INTERVAL=21600
MARKET_PORT=8080
# Internal mirror of gitleaks releases used at image build time (layout: <base>/v<ver>/gitleaks_<ver>_linux_<arch>.tar.gz)
GITLEAKS_BASE_URL=https://github.com/gitleaks/gitleaks/releases/download
